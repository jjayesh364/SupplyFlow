# ==============================================================================
# SupplyFlow: Environment Configuration (Phase 1 Baseline)
# Demonstration Theater: Synthetic Logistics Network
# ==============================================================================

# Core Application
ENVIRONMENT=development
PROJECT_NAME="SupplyFlow - Predictive Logistics Decision Support"
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-change-in-production-32charsmin!
DEMO_THEATER_LABEL="DEMONSTRATION THEATER — SYNTHETIC LOGISTICS NETWORK"
IS_SYNTHETIC_DATA_ONLY=True
DEMO_READ_ONLY_MODE=False

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional read-only AI explanation. Standard free tier only; leave blank to disable.
# Never add a paid billing fallback. Keep the key on FastAPI only, never NEXT_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=60

# Small hosted demo database pool overrides. For local use, omit these to keep defaults.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1

# Database Configuration (PostgreSQL + PostGIS)
# When running via Docker Compose, host is 'db'
# When running locally on host machine, host is 'localhost'
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supplyflow
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/supplyflow
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/supplyflow

# Configurable Logistics Simulation Parameters
DEFAULT_DOS_CRITICAL_THRESHOLD_DAYS=2.0
DEFAULT_DOS_WARNING_THRESHOLD_DAYS=5.0
CONVOY_DAYLIGHT_START_HOUR=6
CONVOY_DAYLIGHT_END_HOUR=17
MAX_ROAD_PASSABLE_SNOW_CM_HR=15.0
DEFAULT_SOLVER_TIME_LIMIT_SECONDS=5.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_THEATER_LABEL="DEMONSTRATION THEATER — SYNTHETIC LOGISTICS NETWORK"
NEXT_PUBLIC_IS_SYNTHETIC_DATA=true
